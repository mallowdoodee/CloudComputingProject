<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>Health Tracker</title>
</head>

<body class="bg-gray-100 text-gray-800">

    <%- include("../partials/nav.ejs") %>

    <main class="max-w-2xl mx-auto p-6">

    <!-- Section heading -->
    <section class="flex items-center justify-between mb-6">
      <h3 class="text-lg font-semibold tracking-wide text-gray-700">Recent Symptoms</h3>
      <a href="#" class="flex items-center justify-center w-8 h-8 rounded-full bg-[#BB271A] text-white text-xl font-bold hover:scale-110 transition">
        +
      </a>
    </section>

    <!-- Symptom card -->
    <article class="p-5 bg-white rounded-2xl shadow-md hover:shadow-lg transition mb-5">
      <!-- Top row: Time + Actions -->
      <div class="flex items-center justify-between">
        <time class="text-sm font-semibold text-gray-500">09:00 AM</time>
        <div class="flex space-x-3">
          <button class="text-blue-500 hover:text-blue-700 transition" aria-label="Edit">
            ✏️
          </button>
          <button class="text-red-500 hover:text-red-700 transition" aria-label="Delete">
            🗑️
          </button>
        </div>
      </div>

      <!-- Bottom row: Topic + Detail -->
      <div class="mt-3">
        <h4 class="text-lg font-bold text-gray-800">ปวดท้อง</h4>
        <p class="text-sm text-gray-600 mt-1">ปวดท้องอย่างรุนแรงข้างขวา</p>
      </div>
    </article>

    <!-- Example of another symptom card -->
    <article class="p-5 bg-white rounded-2xl shadow-md hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <time class="text-sm font-semibold text-gray-500">02:30 PM</time>
        <div class="flex space-x-3">
          <button class="text-blue-500 hover:text-blue-700 transition" aria-label="Edit">
            ✏️
          </button>
          <button class="text-red-500 hover:text-red-700 transition" aria-label="Delete">
            🗑️
          </button>
        </div>
      </div>
      <div class="mt-3">
        <h4 class="text-lg font-bold text-gray-800">เวียนหัว</h4>
        <p class="text-sm text-gray-600 mt-1">เวียนหัวหลังจากออกกำลังกาย</p>
      </div>
    </article>

  </main>

</body>

</html>
